[Unit]
Description=OBS Live Studio Codex YouTube Show Preproduction
After=network-online.target obs-live-studio-pocket-tts.service postgresql.service
Wants=network-online.target obs-live-studio-pocket-tts.service
ConditionPathExists=%h/obs-live-studio/.env

[Service]
Type=oneshot
WorkingDirectory=%h/obs-live-studio
EnvironmentFile=%h/obs-live-studio/.env
Environment=NODE_ENV=production
Environment=AI_PROVIDER=codex
Environment=OPENROUTER_FALLBACK=false
Environment=CODEX_CLI_TIMEOUT_MS=900000
ExecStart=/bin/bash -lc '[[ ! -s "$HOME/.nvm/nvm.sh" ]] || source "$HOME/.nvm/nvm.sh"; exec npm run studio:youtube:preproduce -- --limit 1 --concurrency 1 --delay-ms 0'
TimeoutStartSec=2h
Nice=5
CPUWeight=50
IOWeight=50
NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
